<?xml version="1.0" encoding="utf-8"?>
<!--
  Adaptive icon fyrir Android 8 og nyrra.

  Kerfid klippir taknmyndina i tad form sem framleidandinn velur - hring,
  squircle, ferhyrning - og adeins midjan er orugg. Bakgrunnslagid ber tvi
  alla myndina og framlagid er tomt: tannig heldur senan sig heil hvernig
  sem klippt er.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@drawable/ic_launcher_foreground" />
    <monochrome android:drawable="@drawable/ic_launcher_monochrome" />
</adaptive-icon>
