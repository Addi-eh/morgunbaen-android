    <string name="about_title">Um Morgunbæn</string>
    <string name="about_verse">Á morgnana heyrir þú ákall mitt, Drottinn, á morgnana færi ég þér fórn mína og bíð þín.</string>
    <string name="about_verse_ref">Sálm 5:4</string>
    <string name="about_intro">Ég heiti Adam og bjó til Morgunbæn af því ég vildi vakna við bæn dagsins frá RÚV, sem minnir mig á að biðja og tengjast Drottni einlæglega að morgni hvers dags.</string>
    <string name="about_donate_title">Styrkja</string>
    <string name="about_donate_body">Viljirðu styrkja áframhaldandi vinnu við appið opnast síða með upplýsingum um millifærslu. Styrkur opnar ekkert í appinu — vekjarinn virkar eins fyrir alla.</string>
    <string name="about_donate_button">Opna styrktarsíðu</string>
    <string name="about_help_title">Aðrar leiðir til að hjálpa</string>
    <string name="about_help_body">Að deila appinu, gefa því stjörnu á GitHub eða láta vita af villu hjálpar líka — og kostar ekkert.</string>
    <string name="about_share_app">Deila appinu</string>
